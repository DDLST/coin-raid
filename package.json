{
  "name": "coin-raid",
  "private": true,
  "version": "10.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build:offline": "tsc --noEmit && node scripts/build-offline.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:map": "node scripts/generate-project-map.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run build && npm run build:offline && npm run docs:map:check",
    "docs:map:check": "node scripts/generate-project-map.mjs --check"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
